<!doctype html>
<html lang="uz">
<head>
<meta charset="utf-8" />
<title>Анварович¹¹ — LED emoji (1:3)</title>
<style>
  /* Sahifa markazlashtirish */
  html,body { height:100%; margin:0; display:flex; align-items:center; justify-content:center; background:#222; }
  /* SVG konteyner o'lchami: 512 x 1536 (1:3) — kerak bo'lsa o'zgartiring */
  .frame { width: 360px; /* brauzerda ko'rinishi uchun mos hajm */ }
  /* Agar animatsiya uchun preferensiyalar kerak bo'lsa: */
  @keyframes pulse {
    0%   { opacity:0.35; filter: blur(3px) drop-shadow(0 0 6px rgba(255,90,90,0.12)); }
    40%  { opacity:0.85; filter: blur(0.6px) drop-shadow(0 0 20px rgba(255,80,80,0.45)); }
    60%  { opacity:0.9; filter: blur(0.4px) drop-shadow(0 0 26px rgba(255,120,120,0.55)); }
    100% { opacity:0.4; filter: blur(3px) drop-shadow(0 0 6px rgba(255,90,90,0.12)); }
  }
  /* kichik, noaniq random flash effekt */
  @keyframes flicker {
    0% { opacity: 0.9; }
    3% { opacity: 0.45; }
    7% { opacity: 0.95; }
    10% { opacity: 0.6; }
    30% { opacity: 0.9; }
    100% { opacity: 0.9; }
  }
</style>
</head>
<body>
  <!-- SVG: 512 x 1536 (1:3) -->
  <svg class="frame" viewBox="0 0 512 1536" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Анварович LED">
    <defs>
      <!-- yumuq soya/inner glow uchun -->
      <filter id="softGlow" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur in="SourceGraphic" stdDeviation="6" result="blur"/>
        <feColorMatrix in="blur" type="matrix"
          values="0 0 0 0 0.9
                  0 0 0 0 0.25
                  0 0 0 0 0.25
                  0 0 0 0.7" result="glowColor"/>
        <feMerge>
          <feMergeNode in="glowColor"/>
          <feMergeNode in="SourceGraphic"/>
        </feMerge>
      </filter>

      <!-- nazokatli vignette (chegarani yanada yumshatish uchun) -->
      <radialGradient id="vign" cx="50%" cy="35%" r="80%">
        <stop offset="0%" stop-color="#000" stop-opacity="0" />
        <stop offset="100%" stop-color="#000" stop-opacity="0.45" />
      </radialGradient>

      <!-- LED tekst uchun gradient -->
      <linearGradient id="ledGrad" x1="0" x2="1">
        <stop offset="0%" stop-color="#ff8a8a"/>
        <stop offset="50%" stop-color="#ff4d4d"/>
        <stop offset="100%" stop-color="#ff9b9b"/>
      </linearGradient>

      <!-- Slightly blurred thin stroke for 'soft' edge -->
      <filter id="strokeBlur" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="1.2"/>
      </filter>

      <!-- tekst uchun font fallback -->
      <style type="text/css">
        @font-face {
          font-family: 'SysSans';
          src: local('Arial'), local('Helvetica'), local('Noto Sans');
        }
      </style>
    </defs>

    <!-- Qora, chetlari yumaloq ramka -->
    <rect x="8" y="8" width="496" height="1520" rx="48" ry="48" fill="#000000" stroke="#0a0a0a" stroke-width="2"/>

    <!-- Chegarani biroz silliqlash / blur effect layering -->
    <rect x="8" y="8" width="496" height="1520" rx="48" ry="48" fill="none" filter="url(#softGlow)"/>

    <!-- Markaziy panel (biroz ichkarida, vizual 1:3) -->
    <g transform="translate(0,0)">
      <!-- yengil vignette — chetdan qoraytirish -->
      <rect x="8" y="8" width="496" height="1520" rx="48" ry="48" fill="url(#vign)" opacity="0.12"/>

      <!-- Tekstning 'dim' tagmalagoni (past nurlanish) -->
      <text id="dimText"
            x="256" y="780"
            text-anchor="middle"
            font-family="SysSans, Arial, Helvetica, 'Noto Sans', sans-serif"
            font-size="92"
            letter-spacing="3"
            fill="url(#ledGrad)"
            opacity="0.35"
            style="filter: url(#strokeBlur);">
        Анварович¹¹
      </text>

      <!-- Glow layer: katta blurlangan rangli nuri (hira yonib-o'chadi) -->
      <text id="glowText"
            x="256" y="780"
            text-anchor="middle"
            font-family="SysSans, Arial, Helvetica, 'Noto Sans', sans-serif"
            font-size="92"
            letter-spacing="3"
            fill="url(#ledGrad)"
            opacity="0.0"
            style="filter: blur(6px);">
        Анварович¹¹
      </text>

      <!-- Sharp (yuzaki) tekst — ko'zni o'ziga tortuvchi qatlam -->
      <text id="coreText"
            x="256" y="780"
            text-anchor="middle"
            font-family="SysSans, Arial, Helvetica, 'Noto Sans', sans-serif"
            font-weight="700"
            font-size="92"
            letter-spacing="2"
            fill="#ffb3b3"
            style="stroke: rgba(0,0,0,0.15); stroke-width:1;">
        Анварович¹¹
      </text>

      <!-- O'zgarmas noaniq 'led dot' effekt uchun kichik chiziqlar (text-ga o'xshash blur bilan) -->
      <g id="ledDots" opacity="0.9" style="filter: blur(1px);">
        <!-- optional decorative thin glow under text -->
        <ellipse cx="256" cy="830" rx="148" ry="22" fill="#000" opacity="0.06"/>
      </g>
    </g>

    <!-- ANIMATION with inline CSS (works in modern browsers) -->
    <style>
      /* pulsatsiya: glowText va coreText kombinatsiyasi */
      #glowText {
        animation: pulse 2.2s ease-in-out infinite;
        transform-origin: 50% 50%;
      }
      /* kichik random flicker: core text o'zgarishi */
      #coreText {
        animation: flicker 6s infinite;
      }
      /* dim layerga ham juda nozik pulsatsiya beramiz */
      #dimText {
        animation: pulse 2.2s ease-in-out infinite;
        animation-delay: 0.3s;
      }
    </style>

  </svg>
</body>
</html>
